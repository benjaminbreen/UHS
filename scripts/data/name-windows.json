  "deepTime": {
    "_comment": "Correcting the era floors left a hole under every region: the first attested tradition now starts late, and everything earlier fell through to one global invented-syllable pool. The porter fills that hole per region with the deep-time pool for its culture, running from the beginning of time up to whatever year the region's own earliest plausible option begins. Regions settled late are excluded, because there is nobody there to name.",
    "byCulture": {
      "european": "early-west-eurasia",
      "north-african-west-asian": "early-west-eurasia",
      "inner-eurasian": "early-north-eurasia",
      "east-asian": "early-east-asia",
      "south-asian": "early-south-asia",
      "southeast-asian": "early-sunda",
      "west-central-african": "early-africa",
      "east-southern-african": "early-africa",
      "australian-pacific": "early-sahul",
      "other-indigenous-american": "early-americas",
      "mesoamerican": "early-americas",
      "andean": "early-americas"
    },
    "settledFrom": {
      "_comment": "Places reached late by people. A deep-time window here would invent inhabitants; the region is simply uncovered before this year.",
