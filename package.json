{
  "name": "universal-history-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "art": ".venv/bin/python scripts/build_art.py",
    "art:nature": ".venv/bin/python scripts/build_nature.py",
    "art:fauna": ".venv/bin/python scripts/build_fauna.py",
    "art:fauna-b": ".venv/bin/python scripts/build_fauna_b.py",
    "art:fauna-c": ".venv/bin/python scripts/build_fauna_c.py",
    "art:props": ".venv/bin/python scripts/build_props.py",
    "art:gold": ".venv/bin/python scripts/art/gold_master_sheet.py artifacts/gold-masters.png",
    "art:prehistoric": ".venv/bin/python scripts/art/prehistoric_expansion_sheet.py artifacts/prehistoric-expansion.png",
    "art:regional-houses": ".venv/bin/python scripts/art/regional_house_sheet.py artifacts/roman-west-asian-houses.png",
    "art:asian-houses": ".venv/bin/python scripts/art/asian_house_sheet.py artifacts/east-south-asian-houses.png",
    "art:cultural-kits": ".venv/bin/python scripts/art/cultural_polish_sheet.py artifacts/cultural-settlement-kits.png",
    "art:audit": ".venv/bin/python scripts/art_audit.py",
    "art:front": ".venv/bin/python scripts/art/front_audit.py && .venv/bin/python scripts/art/front_review.py artifacts/front-review.png",
    "build": "tsc -b && vite build && node scripts/build-api.mjs",
    "test": "vitest run",
    "test:full": "FULL=1 vitest run",
    "test:browser": "playwright test",
    "replay": "vite-node scripts/replay.ts --",
    "shot": "tsx scripts/shot.ts",
    "capture:characters": "tsx scripts/capture/characters.ts",
    "capture:terrain": "tsx scripts/capture/terrain.ts",
    "capture:interiors": "tsx scripts/capture/interiors.ts",
    "preview": "vite preview --host 127.0.0.1",
    "agent:serve": "vite-node scripts/agent.ts -- serve",
    "agent:run": "vite-node scripts/agent.ts -- run",
    "prepare:tile-names": ".venv/bin/python scripts/prepare-tile-names.py",
    "prepare:geography": ".venv/bin/python scripts/prepare_geography.py",
    "check": "npm test && npm run build",
    "measure:performance": "node scripts/measure-performance.mjs",
    "prepare:travel-names": ".venv/bin/python scripts/prepare-travel-names.py && .venv/bin/python scripts/prepare-travel-ecoregions.py",
    "prepare:atlas": ".venv/bin/python scripts/prepare_atlas.py && .venv/bin/python scripts/prepare_places.py && node scripts/prepare-atlas-index.mjs",
    "town:sheet": ".venv/bin/python scripts/town-sheet/compose.py --dump"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "^2.0.1",
    "dexie": "4.2.0",
    "h3-js": "4.5.0",
    "lucide-react": "0.542.0",
    "phaser": "3.90.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "prettier": "^3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "^7.3.6",
    "vite-node": "3.2.4",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  },
  "license": "MIT"
}
