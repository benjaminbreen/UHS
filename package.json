{
  "name": "universal-history-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "art": "python3 scripts/build_art.py",
    "art:props": "python3 scripts/build_props.py",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:browser": "playwright test",
    "headless": "tsx scripts/headless.ts",
    "preview": "vite preview --host 127.0.0.1",
    "mcp": "tsx scripts/mcp-server.ts",
    "prepare:geography": ".venv/bin/python scripts/prepare_geography.py",
    "check": "npm test && npm run build",
    "test:graphics": "playwright test tests/browser/graphics-lab.spec.ts tests/browser/lighting.spec.ts",
    "prepare:atlas": "python3 scripts/prepare_atlas.py && python3 scripts/prepare_places.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dexie": "4.2.0",
    "lucide-react": "0.542.0",
    "phaser": "3.90.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "prettier": "^3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
