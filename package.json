{
  "name": "universal-history-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "art": "python3 scripts/build_art.py",
    "art:nature": "python3 scripts/build_nature.py",
    "art:fauna": "python3 scripts/build_fauna.py",
    "art:fauna-b": "python3 scripts/build_fauna_b.py",
    "art:fauna-c": "python3 scripts/build_fauna_c.py",
    "art:props": "python3 scripts/build_props.py",
    "art:gold": "python3 scripts/art/gold_master_sheet.py artifacts/gold-masters.png",
    "art:prehistoric": "python3 scripts/art/prehistoric_expansion_sheet.py artifacts/prehistoric-expansion.png",
    "art:regional-houses": "python3 scripts/art/regional_house_sheet.py artifacts/roman-west-asian-houses.png",
    "art:asian-houses": "python3 scripts/art/asian_house_sheet.py artifacts/east-south-asian-houses.png",
    "art:cultural-kits": "python3 scripts/art/cultural_polish_sheet.py artifacts/cultural-settlement-kits.png",
    "art:audit": "python3 scripts/art_audit.py",
    "build": "tsc -b && vite build && node scripts/build-api.mjs",
    "test": "vitest run",
    "test:full": "FULL=1 vitest run",
    "test:browser": "playwright test",
    "headless": "tsx scripts/headless.ts",
    "shot": "tsx scripts/shot.ts",
    "capture:characters": "tsx scripts/capture/characters.ts",
    "capture:terrain": "tsx scripts/capture/terrain.ts",
    "preview": "vite preview --host 127.0.0.1",
    "mcp": "tsx scripts/mcp-server.ts",
    "prepare:geography": ".venv/bin/python scripts/prepare_geography.py",
    "check": "npm test && npm run build",
    "test:graphics": "playwright test tests/browser/graphics-lab.spec.ts tests/browser/lighting.spec.ts",
    "measure:performance": "node scripts/measure-performance.mjs",
    "prepare:travel-names": "python3 scripts/prepare-travel-names.py && .venv/bin/python scripts/prepare-travel-ecoregions.py",
    "prepare:atlas": "python3 scripts/prepare_atlas.py && python3 scripts/prepare_places.py && node scripts/prepare-atlas-index.mjs",
    "prepare:backbone-names": "tsx scripts/dump-backbone-anchors.ts && python3 scripts/prepare-backbone-names.py",
    "town:sheet": "python3 scripts/town-sheet/compose.py --dump"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dexie": "4.2.0",
    "h3-js": "4.5.0",
    "lucide-react": "0.542.0",
    "phaser": "3.90.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "prettier": "^3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
