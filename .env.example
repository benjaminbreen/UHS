# Procedural play needs no environment variables.
# Optional World Weaver endpoint; never use a VITE_ prefix for secrets.
# World Weaver is on wherever OPENAI_API_KEY is set; set ENABLED=0 to turn it off.
UHS_WORLD_WEAVER_ENABLED=1
OPENAI_API_KEY=
# Optional. Set only to put World Weaver behind a shared code.
UHS_WORLD_WEAVER_ACCESS_CODE=
UHS_WORLD_WEAVER_MODEL=gpt-6-luna
