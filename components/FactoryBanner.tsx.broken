/**
 * components/FactoryBanner.tsx
 * Factory banner component with TimeAwareBackground integration
 */

import React, { useEffect, useMemo, useRef, useState } from 'react';
import TimeAwareBackground from './TimeAwareBackground';
import WeatherEffects from './WeatherEffects';
import { TerrainStructure, ClimateType, Season, TimeOfDay, BiomeType } from '../types';
import type { WeatherState } from '../services/weatherService';

interface FactoryBannerProps {
  structure?: TerrainStructure;
  era?: string;
  culturalZone?: string;
  climate?: ClimateType;
  season: Season;
  timeOfDay: TimeOfDay;
  width?: number;
  height?: number;
  seed?: number;
  adjacentBiomes?: BiomeType[];
  weather?: WeatherState | null;
  enableFxLayer?: boolean;
  industryName?: string;
  isRuined?: boolean;
  productionLevel?: number;
}

const GROUND_Y_DEFAULT = 125;

class RNG {
  private s: number;
  constructor(seed = 1) { this.s = seed || 1; }
  next() { this.s = (this.s * 1664525 + 1013904223) >>> 0; return (this.s & 0xffffffff) / 0x100000000; }
  range(a: number, b: number) { return a + this.next() * (b - a); }
  int(a: number, b: number) { return Math.floor(this.range(a, b + 1)); }
  pick<T>(arr: T[]) { return arr[Math.floor(this.next() * arr.length)]!; }
}

const ipx = (n: number) => Math.round(n);

type TOD = 'dawn'|'day'|'dusk'|'night';
const toTOD = (t: TimeOfDay): TOD => {
  if (t === 'Dawn') return 'dawn';
  if (t === 'Dusk') return 'dusk';
  if (t === 'Night') return 'night';
  return 'day';
};

const getFactoryType = (era?: string) => {
  if (!era) return 'industrial';
  const e = era.toLowerCase();
  if (/^\d{3,4}$/.test(e)) {
    const year = parseInt(e, 10);
    if (year < 1000) return 'workshop';
    if (year >= 1500 && year < 1800) return 'manufactory';
    if (year >= 1800 && year < 1900) return 'industrial';
    if (year >= 1900) return 'modern';
  }
  if (e.includes('medieval')) return 'workshop';
  if (e.includes('early modern') || e.includes('renaissance')) return 'manufactory';
  if (e.includes('industrial')) return 'industrial';
  if (e.includes('modern')) return 'modern';
  return 'industrial';
};

const getArchitectureStyle = (culturalZone?: string, factoryType?: string) => {
  const defaults = {
    materials: { wall: '#8B4513', roof: '#654321', accent: '#4A4A4A' },
    windowStyle: 'rectangular',
    roofStyle: 'peaked',
    hasChimneys: true
  };

  if (culturalZone?.includes('EAST_ASIAN')) {
    return {
      materials: { wall: '#DEB887', roof: '#8B4513', accent: '#DC143C' },
      windowStyle: 'lattice',
      roofStyle: 'pagoda',
      hasChimneys: false
    };
  }

  if (culturalZone?.includes('MENA')) {
    return {
      materials: { wall: '#DEB887', roof: '#CD853F', accent: '#B8860B' },
      windowStyle: 'arched',
      roofStyle: 'dome',
      hasChimneys: false
    };
  }

  return defaults;
};

const FactoryBanner: React.FC<FactoryBannerProps> = ({
  structure,
  era = '1850',
  culturalZone = 'EUROPEAN',
  climate = ClimateType.TEMPERATE,
  season,
  timeOfDay,
  width = 400,
  height = 150,
  seed = 12345,
  adjacentBiomes = [],
  weather,
  enableFxLayer = true,
  industryName = 'General Manufacturing',
  isRuined = false,
  productionLevel = 75
}) => {
  // Derived values
  const tod = toTOD(timeOfDay);
  const factoryType = getFactoryType(era);
  const archStyle = useMemo(() => getArchitectureStyle(culturalZone, factoryType), [culturalZone, factoryType]);

  const isNight = tod === 'night';
  const isIndustrial = factoryType === 'industrial';

  // Layout
  const GROUND_Y = Math.min(GROUND_Y_DEFAULT, Math.max(80, ipx(height * 0.5)));
  const skyHeight = GROUND_Y;
  const FACTORY_Y = GROUND_Y - 60;
  const FACTORY_HEIGHT = 60;
  const FACTORY_WIDTH = 180;

  // RNG
  const staticRng = useMemo(() => new RNG(seed + 9999), [seed]);

  // Animation state
  const [frame, setFrame] = useState(0);
  const frameRef = useRef(0);
  const rafRef = useRef<number>();

  // Particles
  const [smokeParticles, setSmokeParticles] = useState<Array<{
    x: number; y: number; vx: number; vy: number;
    size: number; opacity: number; age: number; maxAge: number;
  }>>([]);

  // Workers
  const [workers, setWorkers] = useState<Array<{
    x: number; y: number; targetX: number; speed: number;
    state: 'walking' | 'working' | 'resting';
    stateTimer: number; direction: 1 | -1;
  }>>([]);

  // Production items
  const [productionItems, setProductionItems] = useState<Array<{
    type: 'crate' | 'barrel' | 'sack' | 'ingot' | 'bale';
    x: number; y: number; moving: boolean;
  }>>([]);

  // Initialize workers
  useEffect(() => {
    if (isRuined || productionLevel === 0) {
      setWorkers([]);
      return;
    }

    const workerCount = Math.floor((productionLevel / 100) * 4);
    const newWorkers = [];

    for (let i = 0; i < workerCount; i++) {
      newWorkers.push({
        x: staticRng.range(50, width - 50),
        y: GROUND_Y - 10,
        targetX: staticRng.range(50, width - 50),
        speed: staticRng.range(0.5, 1.5),
        state: staticRng.pick(['walking', 'working', 'resting']) as 'walking' | 'working' | 'resting',
        stateTimer: staticRng.int(100, 300),
        direction: staticRng.pick([-1, 1]) as 1 | -1
      });
    }

    setWorkers(newWorkers);
  }, [isRuined, productionLevel, GROUND_Y, width]);

  // Initialize production items
  useEffect(() => {
    if (isRuined || productionLevel === 0) {
      setProductionItems([]);
      return;
    }

    const itemCount = Math.floor((productionLevel / 100) * 8);
    const items = [];

    for (let i = 0; i < itemCount; i++) {
      items.push({
        type: staticRng.pick(['crate', 'barrel', 'sack', 'ingot', 'bale']) as 'crate' | 'barrel' | 'sack' | 'ingot' | 'bale',
        x: staticRng.range(50, width - 50),
        y: GROUND_Y - staticRng.int(5, 15),
        moving: false
      });
    }

    setProductionItems(items);
  }, [isRuined, productionLevel, GROUND_Y, width]);

  // Animation loop
  useEffect(() => {
    if (isRuined) return;

    let lastTime = 0;
    const animate = (time: number) => {
      if (time - lastTime > 50) { // ~20 FPS
        lastTime = time;
        frameRef.current++;
        setFrame(frameRef.current);

        // Update smoke particles
        setSmokeParticles(prev => {
          const updated = prev.map(p => ({
            ...p,
            x: p.x + p.vx,
            y: p.y + p.vy,
            vy: p.vy - 0.02,
            size: p.size + 0.1,
            opacity: Math.max(0, p.opacity - 0.01),
            age: p.age + 1
          })).filter(p => p.age < p.maxAge && p.opacity > 0);

          // Add new smoke
          if (frameRef.current % 3 === 0 && productionLevel > 0 && archStyle.hasChimneys) {
            const chimneyX = width / 2 + staticRng.range(-60, 60);
            updated.push({
              x: chimneyX,
              y: FACTORY_Y - 10,
              vx: staticRng.range(-0.5, 0.5),
              vy: -staticRng.range(0.5, 1),
              size: staticRng.range(3, 6),
              opacity: 0.6,
              age: 0,
              maxAge: 200
            });
          }

          return updated;
        });

        // Update workers
        setWorkers(prev => prev.map(worker => {
          const newWorker = { ...worker };

          if (worker.state === 'walking') {
            const dx = worker.targetX - worker.x;
            if (Math.abs(dx) > 2) {
              newWorker.x += Math.sign(dx) * worker.speed;
              newWorker.direction = Math.sign(dx) as 1 | -1;
            } else {
              newWorker.state = 'working';
              newWorker.stateTimer = staticRng.int(50, 150);
            }
          }

          newWorker.stateTimer--;
          if (newWorker.stateTimer <= 0) {
            newWorker.state = 'walking';
            newWorker.targetX = staticRng.range(50, width - 50);
            newWorker.stateTimer = staticRng.int(100, 300);
          }

          return newWorker;
        }));
      }

      rafRef.current = requestAnimationFrame(animate);
    };

    rafRef.current = requestAnimationFrame(animate);

    return () => {
      if (rafRef.current) cancelAnimationFrame(rafRef.current);
    };
  }, [isRuined]);

  // Render functions
  const renderFactory = () => {
    const factoryX = width / 2 - FACTORY_WIDTH / 2;

    return (
      <g>
        {/* Main building */}
        <rect
          x={factoryX}
          y={FACTORY_Y}
          width={FACTORY_WIDTH}
          height={FACTORY_HEIGHT}
          fill={archStyle.materials.wall}
        />

        {/* Roof */}
        <polygon
          points={`${factoryX - 5},${FACTORY_Y} ${factoryX + FACTORY_WIDTH / 2},${FACTORY_Y - 20} ${factoryX + FACTORY_WIDTH + 5},${FACTORY_Y}`}
          fill={archStyle.materials.roof}
        />

        {/* Windows */}
        {Array.from({ length: 6 }).map((_, i) => (
          <rect
            key={i}
            x={factoryX + 15 + i * 25}
            y={FACTORY_Y + 15}
            width={18}
            height={20}
            fill={isNight ? '#FFD700' : '#87CEEB'}
            opacity={isNight ? 0.8 : 0.6}
          />
        ))}

        {/* Chimneys */}
        {archStyle.hasChimneys && (
          <g>
            <rect x={factoryX + 40} y={FACTORY_Y - 40} width={12} height={40} fill="#4A4A4A" />
            <rect x={factoryX + FACTORY_WIDTH - 52} y={FACTORY_Y - 45} width={12} height={45} fill="#4A4A4A" />
          </g>
        )}

        {/* Door */}
        <rect
          x={factoryX + FACTORY_WIDTH / 2 - 10}
          y={FACTORY_Y + 35}
          width={20}
          height={25}
          fill="#654321"
        />
      </g>
    );
  };

  const renderWorkers = () => (
    <g>
      {workers.map((worker, i) => (
        <g key={i} transform={`translate(${ipx(worker.x)}, ${ipx(worker.y)})`}>
          {/* Body */}
          <rect x="-3" y="-8" width="6" height="8" fill="#4B0082" />
          {/* Head */}
          <circle cx="0" cy="-10" r="3" fill="#FDBCB4" />
          {/* Legs */}
          <line x1="-1" y1="0" x2="-1" y2="5" stroke="#4A4A4A" strokeWidth="1.5" />
          <line x1="1" y1="0" x2="1" y2="5" stroke="#4A4A4A" strokeWidth="1.5" />
        </g>
      ))}
    </g>
  );

  const renderParticles = () => (
    <g>
      {smokeParticles.map((p, i) => (
        <circle
          key={`smoke-${i}`}
          cx={ipx(p.x)}
          cy={ipx(p.y)}
          r={p.size}
          fill="#666666"
          opacity={p.opacity}
        />
      ))}
    </g>
  );

  const renderProductionItems = () => (
    <g>
      {productionItems.map((item, i) => {
        if (item.type === 'crate') {
          return (
            <g key={i}>
              <rect x={item.x} y={item.y} width="12" height="10" fill="#8B4513" />
              <line x1={item.x} y1={item.y + 5} x2={item.x + 12} y2={item.y + 5} stroke="#654321" strokeWidth="1" />
            </g>
          );
        } else if (item.type === 'barrel') {
          return (
            <g key={i}>
              <ellipse cx={item.x + 5} cy={item.y + 8} rx="5" ry="8" fill="#654321" />
              <line x1={item.x} y1={item.y + 4} x2={item.x + 10} y2={item.y + 4} stroke="#4A4A4A" strokeWidth="1" />
            </g>
          );
        } else {
          return <rect key={i} x={item.x} y={item.y} width="8" height="4" fill="#C0C0C0" />;
        }
      })}
    </g>
  );

  const renderGround = () => {
    console.log('renderGround called, GROUND_Y:', GROUND_Y, 'height:', height);
    return (
      <g>
        <rect x={0} y={GROUND_Y} width={width} height={height - GROUND_Y} fill="#8B7355" opacity="0.8" />
      {isIndustrial && Array.from({ length: 5 }).map((_, i) => (
        <rect
          key={i}
          x={staticRng.range(20, width - 20)}
          y={GROUND_Y + staticRng.range(0, 10)}
          width={staticRng.range(3, 8)}
          height={staticRng.range(2, 5)}
          fill="#4A4A4A"
          opacity="0.5"
        />
      ))}
    </g>
  );

  // Debug logging
  console.log('FactoryBanner rendering:', {
    width, height, skyHeight, GROUND_Y, FACTORY_Y,
    factoryType, archStyle, isNight, workers: workers.length,
    productionItems: productionItems.length, smokeParticles: smokeParticles.length
  });

  return (
    <div style={{ position: 'relative', width, height, overflow: 'hidden', backgroundColor: '#ff0000' }}>
      {/* Debug overlay */}
      <div style={{
        position: 'absolute', top: 10, left: 10, padding: '8px',
        backgroundColor: 'rgba(0,255,0,0.8)', color: 'black', fontSize: '12px',
        zIndex: 1000, borderRadius: '4px'
      }}>
        Debug: {factoryType} factory, {width}x{height}, workers: {workers.length}
      </div>

      <TimeAwareBackground
        width={width}
        height={skyHeight}
        season={season}
        timeOfDay={timeOfDay}
        climate={climate}
        weather={weather}
        renderAboveSky={(skyHeight) => {
          console.log('renderAboveSky called with skyHeight:', skyHeight);
          return (
            <>
              {/* Direct SVG test without TimeAware dependency */}
              <svg
                width={width}
                height={height}
                viewBox={`0 0 ${width} ${height}`}
                style={{ position: 'absolute', top: 0, left: 0, border: '2px solid blue' }}
              >
                {/* Simple test rectangle */}
                <rect x={10} y={10} width={100} height={50} fill="#00FF00" stroke="#FF0000" strokeWidth="2"/>
                <text x={20} y={35} fill="black" fontSize="12">SVG Test</text>

                {/* Debug each render function */}
                <text x={20} y={80} fill="yellow" fontSize="10">Ground: {renderGround() ? 'OK' : 'FAIL'}</text>
                <text x={20} y={95} fill="yellow" fontSize="10">Items: {renderProductionItems() ? 'OK' : 'FAIL'}</text>
                <text x={20} y={110} fill="yellow" fontSize="10">Factory: {renderFactory() ? 'OK' : 'FAIL'}</text>
                <text x={20} y={125} fill="yellow" fontSize="10">Workers: {renderWorkers() ? 'OK' : 'FAIL'}</text>

                {/* Test simple shapes in expected positions */}
                <rect x={0} y={GROUND_Y} width={width} height={5} fill="brown" opacity="0.8"/>
                <text x={width/2} y={GROUND_Y-10} fill="white" fontSize="12" textAnchor="middle">Ground Line (y={GROUND_Y})</text>

                <rect x={width/2-90} y={FACTORY_Y} width={180} height={60} fill="red" opacity="0.5" stroke="white" strokeWidth="2"/>
                <text x={width/2} y={FACTORY_Y+30} fill="white" fontSize="12" textAnchor="middle">Factory Area</text>

                {/* Actual content */}
                {renderGround()}
                {renderProductionItems()}
                {renderFactory()}
                {renderWorkers()}
                {renderParticles()}

                {isRuined && (
                  <g opacity="0.7">
                    <rect x={0} y={0} width={width} height={height} fill="#8B7355" opacity="0.3" />
                  </g>
                )}
              </svg>
            </>
          );
        }}
      />

      {enableFxLayer && weather && (
        <div style={{ position: 'absolute', top: 0, left: 0, width, height: skyHeight, pointerEvents: 'none' }}>
          <WeatherEffects
            weather={weather}
            width={width}
            height={skyHeight}
            intensity={weather.precipitation || 0.5}
          />
        </div>
      )}
    </div>
  );
};

export default FactoryBanner;